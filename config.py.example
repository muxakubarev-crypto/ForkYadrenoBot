import os

# Загрузка переменных из .env файла (если существует)
# Поддерживаются многострочные значения через тройные кавычки
_ENV_PATH = os.path.join(os.path.dirname(__file__), ".env")
if os.path.isfile(_ENV_PATH):
    with open(_ENV_PATH, "r", encoding="utf-8") as _f:
        for _line in _f:
            _line = _line.strip()
            if not _line or _line.startswith("#"):
                continue
            if "=" not in _line:
                continue
            _key, _, _val = _line.partition("=")
            _key = _key.strip()
            _val = _val.strip().strip('"').strip("'")
            if _key and _key not in os.environ:
                os.environ[_key] = _val

# Telegram Bot API Token
# Получите у @BotFather
BOT_TOKEN = os.getenv("BOT_TOKEN", "ВАШ_ТОКЕН_БОТА")

# Список Telegram ID администраторов бота
_ADMIN_IDS_RAW = os.getenv("ADMIN_IDS", "")
if _ADMIN_IDS_RAW:
    ADMIN_IDS = [int(x.strip()) for x in _ADMIN_IDS_RAW.split(",") if x.strip()]
else:
    ADMIN_IDS = [
        12345678,  # Замените на ваш реальный ID
    ]

# =============================================================================
# DeepSeek AI Agent — конфигурация локального ИИ-агента
# =============================================================================

# API-ключ DeepSeek (обязательный). Получить: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY = os.getenv("DEEPSEEK_API_KEY", "")

# Базовый URL DeepSeek API (OpenAI-совместимый). SDK сам добавит /v1 к пути.
# По умолчанию: https://api.deepseek.com
DEEPSEEK_BASE_URL = os.getenv("DEEPSEEK_BASE_URL", "https://api.deepseek.com")

# Модель DeepSeek. Доступны: deepseek-v4-flash, deepseek-v4-pro
DEEPSEEK_MODEL = os.getenv("DEEPSEEK_MODEL", "deepseek-v4-pro")

# Жёсткий firewall: ИИ-агент доступен ТОЛЬКО этому Telegram ID (строгое int-сравнение)
_ADMIN_TG_ID = os.getenv("ADMIN_TELEGRAM_ID", "")
if _ADMIN_TG_ID:
    try:
        ADMIN_TELEGRAM_ID = int(_ADMIN_TG_ID)
    except ValueError:
        raise ValueError(
            f"ADMIN_TELEGRAM_ID должен быть целым числом (Telegram user ID), "
            f"получено: {_ADMIN_TG_ID!r}"
        )
else:
    # Если не задан — fallback на первый ID из списка ADMIN_IDS
    ADMIN_TELEGRAM_ID = ADMIN_IDS[0] if ADMIN_IDS else 0

# Прокси для DeepSeek API (опционально). Пример: socks5://user:pass@proxy.example.com:1080
# Используется для обхода блокировок ТСПУ в РФ
DEEPSEEK_PROXY = os.getenv("DEEPSEEK_PROXY", "")


################# Ниже необязательные настройки ################# 

# Ссылка на GitHub репозиторий для автообновления
# Формат: https://github.com/username/repo.git или git@github.com:username/repo.git
GITHUB_REPO_URL = os.getenv("GITHUB_REPO_URL", "https://github.com/plushkinv/YadrenoVPN.git")

# Client Configuration Defaults
DEFAULT_LIMIT_IP = int(os.getenv("DEFAULT_LIMIT_IP", "1"))
DEFAULT_TOTAL_GB = int(os.getenv("DEFAULT_TOTAL_GB", str(1024 * 1024 * 1024 * 1024)))  # 1 TB

# Rate Limiting Configuration
RATE_LIMITS = {
    "commands_per_minute": int(os.getenv("RATE_LIMIT_COMMANDS", "30")),
    "critical_operations_per_minute": int(os.getenv("RATE_LIMIT_CRITICAL", "5")),
}

# Retry Configuration for API calls
RETRY_CONFIG = {
    "max_attempts": int(os.getenv("RETRY_MAX_ATTEMPTS", "3")),
    "delays": [
        int(x.strip())
        for x in os.getenv("RETRY_DELAYS", "1,3,9").split(",")
        if x.strip()
    ] or [1, 3, 9],
}
