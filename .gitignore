# Unignore specific files
!README.MD
!.gitignore

# Explicitly ignore these (redundant due to * but good for clarity/overrides if I change * later)
config.py
logs/
tests/
docs/
results.md
AGENTS.md
.agents/
tmp/
**/__pycache__/
.vscode

# База данных (создаётся автоматически при запуске)
database/vpn_bot.db

# Локальные бэкапы (создаются автоматически планировщиком)
backup/

# Virtual Environment
venv/
env/
.venv/
.env/
env*/
venv*/
.env

# Снапшоты с НЕмаскированными настройками (--include-settings-unsafe). Никогда в git!
snapshots/**/*-unsafe/
snapshots/**/*-unsafe
snapshots/**/unsafe-*/

# Любые SQLite базы (защита если кто-то положил .db не в database/)
*.db
*.db-journal
*.sqlite
*.sqlite3
*.bak-*

# Файлы со снятыми ключами/секретами
*secret*.json
*secret*.yaml
*credentials*.json
*credentials*.txt
.git-credentials
**/secrets/
**/private/
